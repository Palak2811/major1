# Copy to backend/.env (never commit .env). Everything is optional for a local run.

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-me-with-a-long-random-string

# --- Database ---
# Default: local SQLite file (zero setup; vector columns fall back to JSON).
# For real pgvector search, use a free hosted Postgres with pgvector, e.g. Neon (neon.tech):
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DBNAME?ssl=require
DATABASE_URL=sqlite+aiosqlite:///./dev.db

# --- Redis (optional) ---
# Empty => no cache, no rate limiting, background tasks run in-process.
# Free hosted option: Upstash (use the rediss:// URL).
REDIS_URL=

# --- Web ---
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
# Set to true once served over HTTPS
COOKIE_SECURE=false

# --- Google OAuth2 (optional) ---
# Empty GOOGLE_CLIENT_ID => MOCK MODE: "Continue with Google" signs in a fixed demo
# identity (google.demo@preppath.dev) and the UI says so.
# Real setup: Google Cloud Console -> Credentials -> OAuth client (Web); add the redirect URI below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback

# --- Rate limiting (needs REDIS_URL) ---
RATE_LIMIT_ENABLED=false

# --- Seeded admin account ---
SEED_ADMIN_EMAIL=admin@preppath.dev
SEED_ADMIN_PASSWORD=ChangeMe-Admin1

# --- LLM: Google Gemini free tier (used from Phase 4) ---
# Free key: https://aistudio.google.com/apikey . Empty => labelled mock mode.
GEMINI_API_KEY=
LLM_MODEL_FAST=gemini-flash-lite-latest
LLM_MODEL_STRONG=gemini-flash-latest
EMBEDDING_MODEL=gemini-embedding-001

# --- Judge0 CE code sandbox (used from Phase 3) ---
# Free public Judge0 CE instance, no key needed (rate-limited; fine for dev/demo).
JUDGE0_URL=https://ce.judge0.com
JUDGE0_API_KEY=
